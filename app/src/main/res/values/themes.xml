<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Buddy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/buddy_amber_primary</item>
        <item name="colorPrimaryVariant">@color/buddy_amber_dark</item>
        <item name="colorOnPrimary">@color/buddy_text_on_amber</item>
        <item name="colorSecondary">@color/buddy_orange_accent</item>
        <item name="colorOnSecondary">@color/buddy_text_on_amber</item>
        <item name="android:windowBackground">@color/buddy_bg</item>
        <item name="colorSurface">@color/buddy_surface</item>
        <item name="colorOnSurface">@color/buddy_text_primary</item>
        <item name="android:statusBarColor">@color/buddy_bg</item>
        <item name="android:navigationBarColor">@color/buddy_surface</item>
    </style>

    <style name="Theme.Buddy.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/buddy_surface_elevated</item>
        <item name="colorOnSurface">@color/buddy_text_primary</item>
        <item name="colorPrimary">@color/buddy_amber_primary</item>
