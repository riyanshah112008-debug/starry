<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/buddy_surface"
    tools:context=".MainActivity">

    <!-- ===================== CONTENT ===================== -->
    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/buddy_surface"
        android:orientation="vertical">

        <!-- Top bar: hamburger + model switcher + new chat -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/buddy_text_primary" />

            <LinearLayout
                android:id="@+id/modelSwitcher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvTopTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/buddy_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/status_ready"
                    android:textColor="@color/buddy_text_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/buddy_text_secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNewChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/new_chat"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/buddy_text_primary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                tools:listitem="@layout/item_msg_assistant" />

            <ScrollView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/buddy_amber_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/empty_greeting"
                        android:textColor="@color/buddy_text_secondary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/suggestion_1"
                        android:textAllCaps="false"
                        android:textColor="@color/buddy_text_primary"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/buddy_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/suggestion_2"
                        android:textAllCaps="false"
                        android:textColor="@color/buddy_text_primary"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/buddy_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip3"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/suggestion_3"
                        android:textAllCaps="false"
                        android:textColor="@color/buddy_text_primary"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/buddy_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip4"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/suggestion_4"
                        android:textAllCaps="false"
                        android:textColor="@color/buddy_text_primary"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/buddy_border" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Composer -->
        <LinearLayout
            android:id="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/buddy_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp">

            <LinearLayout style="@style/BuddyComposer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnVoice"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voice_button"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/buddy_text_secondary" />

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="44dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/buddy_text_primary"
                    android:textColorHint="@color/buddy_text_secondary"
                    android:textSize="15sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send"
                android:contentDescription="@string/send_button"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/buddy_on_amber" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== DRAWER ===================== -->
    <LinearLayout
        android:id="@+id/drawerContent"
        android:layout_width="308dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/accountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="B"
                android:textColor="@color/avatar_buddy_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/not_signed_in"
                    android:textColor="@color/buddy_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/sign_in_subtitle"
                    android:textColor="@color/buddy_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sign_in_with_google"
            android:textAllCaps="false"
            android:textColor="@color/buddy_text_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/buddy_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewChatDrawer"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/new_chat"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconTint="@color/buddy_text_primary"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="10dp"
            android:text="@string/recent"
            android:textColor="@color/buddy_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSessions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_session" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingsDrawer"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:textColor="@color/buddy_text_primary"
            app:icon="@android:drawable/ic_menu_preferences"
            app:iconTint="@color/buddy_text_secondary" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
